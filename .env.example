# Envoi du formulaire de contact (SMTP Gmail)
# Le mot de passe doit etre un "mot de passe d'application" Google, pas le mot de
# passe du compte : https://myaccount.google.com/apppasswords
SMTP_USER=cassardjean@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Optionnels (valeurs par defaut ci-dessous)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Destinataire(s) des demandes. Plusieurs adresses possibles, separees par une virgule.
CONTACT_TO_EMAIL=cassardjean@gmail.com,cassard.sc@outlook.fr

# Expediteur. Gmail impose une adresse correspondant au compte authentifie.
CONTACT_FROM_EMAIL=Site Cassard <cassardjean@gmail.com>
